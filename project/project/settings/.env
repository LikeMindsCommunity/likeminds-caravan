# CACHE_PORT=6379
# ELASTIC_SEARCH_HOST="caravan_elasticsearch:9200"
# BROKER_URL=amqp://guest:guest@caravan_rabbitmq:5672
# SUBSCRIPTION_SERVER_URL=http://skulk:8080
# SWARM_BASE_URL=http://swarm:8081
# KETTLE_BASE_URL=http://auth:8080
# PANDEMONIUM_BASE_URL=http://pandemonium:8081