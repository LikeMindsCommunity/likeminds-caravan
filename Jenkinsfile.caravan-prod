pipeline {
    agent any
    environment {
        PROJECT_ID = 'likeminds-prod-prj-5464'
        CLUSTER_NAME = 'likeminds-prod-autopilot-cluster'
        LOCATION = 'asia-south1'
        CREDENTIALS_ID = 'likeminds-prod-prj-5464'
    }
   
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
        }
        stage("Executing the Script Migration step for caravan-prod") {
          when { changeset "Migrationfile-caravan-prod.sh"}
            steps {
                script{
                    sh '''
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command="chmod +x /home/apps/caravan-prod/Together/Migrationfile-caravan-prod.sh"
                       gcloud compute ssh likeminds-nonprod-migration-vm --zone=asia-south1-a --internal-ip --command=". /home/apps/caravan-prod/Together/Migrationfile-caravan-prod.sh"
                      '''
                }
                
            }
        }
      
        stage("Building Application Docker Image"){
          when { changeset "Dockerfile.caravan-prod"}
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker build -f Dockerfile.caravan-prod -t asia.gcr.io/likeminds-prod-prj-5464/togther/caravan-prod:${BUILD_NUMBER} . '
                    }
                }
            }
         stage("Pushing Application Docker Image to Google Artifact Registry"){
           when { changeset "Dockerfile.caravan-prod"}
            steps{
                script{
                    sh 'gcloud auth configure-docker asia.gcr.io'
                    sh 'docker push asia.gcr.io/likeminds-prod-prj-5464/togther/caravan-prod:${BUILD_NUMBER}'
                      }
                 }
            }
              
        stage('Deploy to GKE') {
          when { changeset "Dockerfile.caravan-prod"}
            steps{
                
                sh "sed 's/caravan-prod:.*/caravan-prod:${BUILD_NUMBER}/g' deployment-caravan-prod.yaml"
                sh "gcloud container clusters get-credentials ${env.CLUSTER_NAME} --region ${env.LOCATION} --project ${env.PROJECT_ID} --internal-ip"
                sh 'kubectl apply -f /var/lib/jenkins/workspace/likeminds-caravan-prod/deployment-caravan-prod.yaml'
                
            }
        }
    }  
        post { 
        always { 
            cleanWs()
        }
    }

}
