pipeline {
    agent any
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
         }
        
        stage ("Download .env file from s3") {
            steps{
                withAWS(region:"ap-south-1", credentials:"AWS-S3-ENV"){
                    s3Download(file:'./project/project/settings/.env', bucket:'likeminds-configs-prod', path:'application-dot-envs-prod/caravan-prod/caravan-prod-dot-env-private', force: true)
                }
            }
        }

        stage ('Build Image') {
            steps {
                sh "sudo docker build -f Dockerfile.caravan-celery-es-prod -t 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-celery-es-repo:caravan-celery-es-V$BUILD_NUMBER ."
            }
        }
        
        stage ('Push Image') {
            steps {
                sh "aws ecr get-login-password --region ap-south-1 | sudo docker login --username AWS --password-stdin 523792672653.dkr.ecr.ap-south-1.amazonaws.com"
                sh "sudo docker push 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-celery-es-repo:caravan-celery-es-V$BUILD_NUMBER"
            }
        }
        
        stage ('Remove Image from jenkins') {
            steps {
                sh "sudo docker rmi 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-celery-es-repo:caravan-celery-es-V$BUILD_NUMBER"
            }
        }
        stage ("update tag and push helm charts") {
          steps {
             script{
                  git branch: 'LM-10466-aws-migration', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
                  sh "ls"
                  sh 'sed -i "s/tag: caravan-celery-es-V[0-9]*/tag: caravan-celery-es-V${BUILD_NUMBER}/g" ./prod/caravan-celery-es-prod/values.yaml'
                  sh "git add ./prod/caravan-celery-es-prod/values.yaml"
                  sh "git status"
                  sh 'git commit -m "CI/CD pipeline updated $IMAGE_TAG image to new image tag"'
                  sh 'git config --global credential.helper cache'
		  sh "git push origin LM-10466-aws-migration"
                }
            }
        }
    }
}
