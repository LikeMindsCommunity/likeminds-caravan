pipeline {
    agent any

    parameters {
        booleanParam(name: 'run_migrations', defaultValue: false, description: 'Run migrations on the migration instance')
        string(name: 'migration_server_IP', defaultValue: '10.53.156.135', description: 'Migration instance server IP')
    }

    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
         }

        stage("Executing the Script Migration step for caravan-prod") {
            when {
                expression { params.run_migrations == true }
            }
            steps {
                script{
                    sh """ssh -tt -i "/var/lib/jenkins/.ssh/prod_ssh_keys" root@$migration_server_IP << EOF
                    cd /home/apps/caravan-prod/Togther && git checkout master && git pull
                    chmod +x /home/apps/caravan-prod/likeminds-caravan/Migrationfile-caravan-prod.sh
                    . /home/apps/caravan-prod/likeminds-caravan/Migrationfile-caravan-prod.sh
                    cd /home/apps/caravan-prod/Togther && git checkout /home/apps/caravan-prod/likeminds-caravan/Migrationfile-caravan-prod.sh
                    exit
                    EOF"""
                }
            }
        }
        
        stage ("Download .env file from s3") {
            steps{
                withAWS(region:"ap-south-1", credentials:"AWS-S3-ENV"){
                    s3Download(file:'./project/project/settings/.env', bucket:'likeminds-configs-prod', path:'application-dot-envs-prod/caravan-prod/caravan-prod-dot-env-private', force: true)
                }
            }
        }

        stage ('Build Image') {
            steps {
                sh "sudo docker build -f Dockerfile.caravan-prod -t 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER ."
            }
        }
        
        stage ('Push Image') {
            steps {
                sh "aws ecr get-login-password --region ap-south-1 | sudo docker login --username AWS --password-stdin 523792672653.dkr.ecr.ap-south-1.amazonaws.com"
                sh "sudo docker push 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER"
            }
        }
        
        stage ('Remove Image from jenkins') {
            steps {
                sh "sudo docker rmi 523792672653.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER"
            }
        }
        stage ("update tag and push helm charts") {
          steps {
             script{
                  git branch: 'LM-10466-aws-migration', url: 'git@github.com:LikeMindsCommunity/likeminds-infra-config.git'
                  sh "ls"
                  sh 'sed -i "s/tag: caravan-V[0-9]*/tag: caravan-V${BUILD_NUMBER}/g" ./prod/caravan-prod/values.yaml'
                  sh "git add ./prod/caravan-prod/values.yaml"
                  sh "git status"
                  sh 'git commit -m "CI/CD pipeline updated $IMAGE_TAG image to new image tag"'
                  sh 'git config --global credential.helper cache'
		  sh "git push origin LM-10466-aws-migration"
                }
            }
        }
    }
}
