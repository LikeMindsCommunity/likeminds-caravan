pipeline {
    agent any
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
         }
        
        stage ('Build Image') {
            steps {
                sh "sudo docker build -f Dockerfile.caravan-beta -t 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER ."
            }
        }
        
        stage ('Push Image') {
            steps {
                sh "aws ecr get-login-password --region ap-south-1 | sudo docker login --username AWS --password-stdin 081371230266.dkr.ecr.ap-south-1.amazonaws.com"
                sh "sudo docker push 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER"
            }
        }
        
        stage ('Remove Image from jenkins') {
            steps {
                sh "sudo docker rmi 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-togther-caravan-repo:caravan-V$BUILD_NUMBER"
        }
        stage ("update tag and push helm charts") {
          steps {
             script{
                  git branch: 'LM-10466-aws-migration', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
                  sh "ls"
                  sh 'sed -i "s/tag: caravan-V[0-9]*/tag: caravan-V${BUILD_NUMBER}/g" ./stag/caravan-beta/values.yaml'
                  sh "git add ./stag/caravan-beta/values.yaml"
                  sh "git status"
                  sh 'git commit -m "CI/CD pipeline updated $IMAGE_TAG image to new image tag"'
                  sh 'git config --global credential.helper cache'
		  sh "git push origin LM-10466-aws-migration"
                }
            }
          }   
        }
    }
}
