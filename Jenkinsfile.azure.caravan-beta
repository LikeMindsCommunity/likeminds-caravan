pipeline {
    agent any

    environment {
        // Azure Blob Storage Credentials
        AZURE_STORAGE_ACCOUNT = 'likemindsstagingstorage'
        AZURE_STORAGE_CONTAINER = 'likeminds-staging-configs'
        BLOB_NAME = 'caravan-beta/caravan-beta-dot-env-private'
        DOWNLOAD_PATH = './project/project/settings/.env'

        // Azure Container Registry Credentials
        ACR_NAME = 'likemindsstagingregistry'
        ACR_LOGIN_SERVER = 'likemindsstagingregistry.azurecr.io'
    }

    parameters {
        booleanParam(name: 'run_migrations', defaultValue: false, description: 'Run migrations on the migration instance')
        string(name: 'migration_server_IP', defaultValue: '10.57.160.12', description: 'Migration instance server IP')
    }

    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
        }

        stage("Executing the Script Migration step for caravan-beta") {
            when {
                expression { params.run_migrations == true }
            }
            steps {
                script {
                    withCredentials([
                        sshUserPrivateKey(credentialsId: 'likeminds-staging-azure-pem-file', keyFileVariable: 'SSH_KEY'),
                        string(credentialsId: 'likeminds-staging-service-principal-jenkins-credentials', variable: 'AZURE_CREDENTIALS')
                    ]) {

                        sh """
                            mkdir -p ~/.ssh
                            chmod 700 ~/.ssh

                            # Add the host to known_hosts
                            ssh-keyscan -H ${migration_server_IP} >> ~/.ssh/known_hosts

                            # Run remote commands in a single ssh line using bash -c
                            ssh -i ${SSH_KEY} -o StrictHostKeyChecking=yes likeminds-staging-vm-user@${migration_server_IP} \\
                            "sudo bash -c '
                                echo $AZURE_CREDENTIALS > azure_credentials.json
                                cat azure_credentials.json
                                export CLIENT_ID=\\\$(jq -r .clientId azure_credentials.json)
                                echo CLIENT_ID=\\\$CLIENT_ID

                                cd /home/apps/caravan-beta/Togther && git checkout LM-13902-ankit-jenkins-migration-deployment && git pull
                                chmod +x /home/apps/caravan-beta/Togther/Migrationfile-azure-caravan-beta.sh
                                . /home/apps/caravan-beta/Togther/Migrationfile-azure-caravan-beta.sh
                                cd /home/apps/caravan-beta/Togther
                                git checkout -- /home/apps/caravan-beta/Togther/Migrationfile-azure-caravan-beta.sh
                            '"
                        """
                    }
                }
            }
        }

        stage('Login to Azure') {
            steps {
                withCredentials([string(credentialsId: 'likeminds-staging-service-principal-jenkins-credentials', variable: 'AZURE_CREDENTIALS')]) {
                    sh '''
                        set +x
                        echo $AZURE_CREDENTIALS > azure_credentials.json
                        az login --service-principal -u \"$(jq -r .clientId azure_credentials.json)\" \
                                -p \"$(jq -r .clientSecret azure_credentials.json)\" \
                                --tenant \"$(jq -r .tenantId azure_credentials.json)\"
                        set -x
                        echo 'silent login to azure successful'
                    '''
                }
            }
        }

        stage('Download File from Azure Blob') {
            steps {
                sh '''
                    az storage blob download --account-name $AZURE_STORAGE_ACCOUNT \
                    --container-name $AZURE_STORAGE_CONTAINER \
                    --name $BLOB_NAME \
                    --file $DOWNLOAD_PATH \
                    --auth-mode login
                '''
            }
        }

        stage('Login to ACR') {
            steps {
                sh '''
                    set +x
                    docker login $ACR_LOGIN_SERVER -u "$(jq -r .clientId azure_credentials.json)" \
                    -p "$(jq -r .clientSecret azure_credentials.json)"
                    set -x
                    echo 'silent login to ACR successful'
                '''
            }
        }


        stage ('Build Image') {
            steps {
                sh '''
                    docker build -f Dockerfile.caravan-beta -t $ACR_LOGIN_SERVER/likeminds-caravan/caravan-staging:caravan-V$BUILD_NUMBER .
                '''
            }
        }


        stage ('Push Image') {
            steps {
                sh '''
                    az acr login --name $ACR_NAME
                    docker push $ACR_LOGIN_SERVER/likeminds-caravan/caravan-staging:caravan-V$BUILD_NUMBER
                '''
            }
        }

        stage ('Remove Image from jenkins') {
            steps {
                sh "docker rmi $ACR_LOGIN_SERVER/likeminds-caravan/caravan-staging:caravan-V$BUILD_NUMBER"
            }
        }

        stage ("update tag and push helm charts") {
          steps {
             script{
                  git branch: 'LM-13485-azure-migration', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
                  sh "ls"
                  sh 'sed -i "s/tag: caravan-V[0-9]*/tag: caravan-V${BUILD_NUMBER}/g" ./azure/staging/caravan-beta/values.yaml'
                  sh "git add ./azure/staging/caravan-beta/values.yaml"
                  sh "git status"
                  sh 'git commit -m "CI/CD pipeline updated $IMAGE_TAG image to new image tag"'
                  sh 'git config --global credential.helper cache'
		          sh "git push origin LM-13485-azure-migration"
                }
            }
        }
    }
}
